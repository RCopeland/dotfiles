# Ignore all files by default
*

# Allow tracking of specific folders and core structures
!*/
!.gitignore

# --- TRACK THESE ---
# NOTE: agents/, skills/, and AGENTS.md are owned by the ai-docs repo
# (https://github.com/RCopeland/ai-docs). This repo no longer ships them.
!agent/settings.json
!agent/mcp.json
!agent/extensions/**
!agent/themes/**
!agent/npm/.gitignore
!agent/

# --- EXCLUDE THESE ---
agent/auth.json
agent/sessions/**
agent/logs/**
agent/npm/**
!agent/npm/.gitignore
agent/git/**
agent/cache/**
agent/mcp-cache.json
agent/mcp-npx-cache.json
agent/models-store.json
